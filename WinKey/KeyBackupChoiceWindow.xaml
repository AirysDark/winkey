<Window x:Class="WinKey.KeyBackupChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Key to Back Up"
        Width="470"
        Height="255"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F14"
        Foreground="#E6E6E6">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Choose the Windows key to back up" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Select one key. The backup file will contain only the selected 25-character product key."
                       Foreground="#9FB0C3" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,18">
            <RadioButton x:Name="InstalledKeyOption"
                         Content="Installed Key"
                         GroupName="KeyType"
                         IsChecked="True"
                         IsEnabled="True"
                         FontSize="16"
                         Padding="4"
                         Margin="0,0,0,2"
                         Click="InstalledKeyOption_Click"/>
            <TextBlock Text="The product key currently installed in Windows."
                       Foreground="#9FB0C3" Margin="32,0,0,12"/>

            <RadioButton x:Name="OemKeyOption"
                         Content="OEM/UEFI Key"
                         GroupName="KeyType"
                         IsEnabled="True"
                         FontSize="16"
                         Padding="4"
                         Margin="0,0,0,2"
                         Click="OemKeyOption_Click"/>
            <TextBlock Text="The product key embedded in the PC firmware. This option remains selectable whenever you choose it."
                       Foreground="#9FB0C3" TextWrapping="Wrap" Margin="32,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="100" Height="34" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Continue" Width="110" Height="34" Background="#FF6A00" Foreground="#101010" Click="Continue_Click"/>
        </StackPanel>
    </Grid>
</Window>
