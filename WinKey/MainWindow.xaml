<Window x:Class="WinKey.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinKey - Windows Reinstall Information" Height="720" Width="1050" MinHeight="600" MinWidth="850">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="WinKey" FontSize="30" FontWeight="Bold"/>
      <TextBlock Text="Windows product key, activation and computer information for reinstallation." Opacity="0.7"/>
    </StackPanel>
    <TabControl Grid.Row="1">
      <TabItem Header="Windows &amp; Licence"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="Windows Information" FontSize="20" FontWeight="Bold"/><TextBox x:Name="WindowsInfoBox" Margin="0,10,0,12" FontFamily="Consolas" FontSize="14" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="420"/><TextBlock Text="Recovered keys should be kept private. A digital licence may activate Windows without a recoverable 25-character key." TextWrapping="Wrap" Opacity="0.75"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Hardware"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="Hardware Information" FontSize="20" FontWeight="Bold"/><TextBox x:Name="HardwareInfoBox" Margin="0,10,0,12" FontFamily="Consolas" FontSize="14" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="500"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Network"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="Network Information" FontSize="20" FontWeight="Bold"/><TextBox x:Name="NetworkInfoBox" Margin="0,10,0,12" FontFamily="Consolas" FontSize="14" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="500"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Full Report"><Grid Margin="16"><TextBox x:Name="ReportBox" FontFamily="Consolas" FontSize="13" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Grid></TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Refresh" Width="100" Margin="4" Click="Refresh_Click"/>
      <Button Content="Copy All" Width="100" Margin="4" Click="CopyAll_Click"/>
      <Button Content="Export TXT" Width="100" Margin="4" Click="ExportTxt_Click"/>
      <Button Content="Export JSON" Width="100" Margin="4" Click="ExportJson_Click"/>
    </StackPanel>
  </Grid>
</Window>
